# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time.

# Force the scripted mock replay (always shows a MOCK DATA banner). Also: open any page with ?mock=1
NEXT_PUBLIC_SILICR_MOCK=0

# Local daemons (they must send CORS headers allowing http://localhost:7703)
NEXT_PUBLIC_BUYER_URL=http://127.0.0.1:7701
NEXT_PUBLIC_PROVIDER_URL=http://127.0.0.1:7702
NEXT_PUBLIC_RELAY_URL=http://127.0.0.1:7700

# Block-explorer links for txids ({txid} is replaced), one per real network. No link on a simulated chain.
# Explorers are third parties: opening a link tells them which txid you are looking at, from your browser's IP.
NEXT_PUBLIC_EXPLORER_TX_URL_MAIN=https://mainnet.zcashexplorer.app/transactions/{txid}
# Alternatives seen rendering v6 (Ironwood) transactions: https://zecblock.com/tx/{txid} (rate-limits repeated fetches)
NEXT_PUBLIC_EXPLORER_TX_URL_TEST=https://zexplorer.app/testnet/tx/{txid}
# Older name for the testnet template; still honoured when NEXT_PUBLIC_EXPLORER_TX_URL_TEST is unset.
# NEXT_PUBLIC_EXPLORER_TX_URL=https://zexplorer.app/testnet/tx/{txid}
NEXT_PUBLIC_LANDING_URL=http://127.0.0.1:7704   # the logo links here; set to the deployed landing page
