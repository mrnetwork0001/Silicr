# Copy to .env.local. NEXT_PUBLIC_* values are inlined when the static site is built,
# so rebuild (or restart `next dev`) after changing them.

# Where every "Launch app" button points. Default: the local web terminal.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:7703

# Optional. The hosted mainnet demo (real ZEC, tiny hard-capped shared wallet), e.g. https://mainnet.silicr.xyz.
# Unset: the "Real ZEC demo" link in the final CTA is hidden.
NEXT_PUBLIC_MAINNET_URL=

# Optional. Public source repository, e.g. https://github.com/<org>/silicr.
# Unset: the Source, Threat model and clone links are hidden (file names are shown as plain text).
NEXT_PUBLIC_REPO_URL=

# Optional. Branch used for links to files in the repo (…/blob/<branch>/THREAT_MODEL.md). Default: main.
NEXT_PUBLIC_REPO_BRANCH=

# Optional. Recorded demo video. Unset: the "Watch the demo" links are hidden.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Optional. Public URL this page is served from, e.g. https://silicr.example.
# Only used to make the Open Graph / Twitter image URL absolute; unset, those image tags are left out.
NEXT_PUBLIC_SITE_URL=
