{
  "name": "@silicr/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server: lets an AI agent rent GPU compute on Silicr and pay in shielded ZEC through the local buyer daemon",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node ./bin/silicr-mcp.js",
